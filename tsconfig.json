{
    // Node >=26.12.1 only. Sources are never emitted: `tsc` only typechecks,
    // and Node runs the .ts files directly via type stripping.
    // https://nodejs.org/docs/latest-v26.x/api/typescript.html#type-stripping
    "compilerOptions": {
        // Runtime environment
        "target": "esnext",
        "lib": ["esnext"],
        "types": ["node"],

        // Modules: model Node's own resolution exactly
        "module": "nodenext",
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,

        // Reject TS syntax that type stripping can't handle
        // (enums, runtime namespaces, parameter properties, import aliases)
        "erasableSyntaxOnly": true,

        // Strictness
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
    },
}
